name = "xiguaAp6y3/moon-httpsig"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/xiguaAp6y3/moon-httpsig"

license = "Apache-2.0"

description = "RFC 9421 HTTP Message Signatures canonicalization, HMAC signing, verification, and policy toolkit for MoonBit."

keywords = [
  "http",
  "signature",
  "rfc9421",
  "security",
  "hmac",
  "webhook",
  "api",
  "integrity",
  "moonbit",
]

import {
  "gmlewis/sha256@0.17.32",
}

warnings = "-reserved_keyword"
